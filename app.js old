const $=id=>document.getElementById(id);
const KEY='ranaFarmKhata_v1';
let db={fields:[],expenses:[],sales:[],ledger:[],settings:{name:'Rana Farm Khata'}};
let deferredInstall=null;
const today=()=>new Date().toISOString().slice(0,10);
$('expDate').value=$('saleDate').value=$('ledDate').value=today();
function load(){try{const raw=localStorage.getItem(KEY);if(raw)db={...db,...JSON.parse(raw)};}catch(e){alert('محفوظ ریکارڈ پڑھنے میں مسئلہ ہوا۔ بیک اپ فائل موجود ہو تو واپس لائیں۔')}applySettings();renderAll();}
function save(){localStorage.setItem(KEY,JSON.stringify(db));renderAll();}
function uid(){return Date.now().toString(36)+Math.random().toString(36).slice(2,7)}
function n(v){return Number(v)||0}
function money(v){return new Intl.NumberFormat('en-PK',{maximumFractionDigits:2}).format(n(v))+' روپے'}
function esc(s){return String(s??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]))}
function fieldName(id){return db.fields.find(f=>f.id===id)?.name||'عمومی / حذف شدہ زمین'}
function total(arr,key='amount'){return arr.reduce((s,x)=>s+n(x[key]),0)}
function nav(view){document.querySelectorAll('.view').forEach(v=>v.classList.toggle('hidden',v.id!==view));document.querySelectorAll('.tab').forEach(b=>b.classList.toggle('active',b.dataset.view===view));if(view==='reports')runReport();}
document.querySelectorAll('.tab').forEach(b=>b.onclick=()=>nav(b.dataset.view));
document.querySelectorAll('[data-go]').forEach(b=>b.onclick=()=>nav(b.dataset.go));
function options(id,includeAll=false){const el=$(id);if(!el)return;const old=el.value;const first=includeAll?'<option value="">تمام زمینیں</option>':'<option value="">زمین منتخب کریں</option>';el.innerHTML=first+db.fields.map(f=>`<option value="${f.id}">${esc(f.name)} (${esc(f.acres)} ایکڑ)</option>`).join('');if([...el.options].some(o=>o.value===old))el.value=old;}
function refreshOptions(){['expField','saleField','ledField','filterExpenseField','reportField'].forEach(id=>options(id,['filterExpenseField','reportField','ledField'].includes(id)));}
function table(headers,rows){if(!rows.length)return '<div class="empty">ابھی کوئی ریکارڈ موجود نہیں۔</div>';return `<div class="table-wrap"><table><thead><tr>${headers.map(h=>`<th>${h}</th>`).join('')}</tr></thead><tbody>${rows.join('')}</tbody></table></div>`}
function actionBtns(type,id){return `<button class="smallbtn danger" data-delete="${type}" data-id="${id}">حذف</button>`}
function renderAll(){refreshOptions();renderDashboard();renderFields();renderExpenses();renderSales();renderLedger();$('brandName').textContent=db.settings.name||'Rana Farm Khata';$('settingName').value=db.settings.name||'Rana Farm Khata';}
function fieldExpenses(id){return db.expenses.filter(x=>x.fieldId===id)}
function fieldSales(id){return db.sales.filter(x=>x.fieldId===id)}
function fieldExpenseTotal(id){return total(fieldExpenses(id))}
function fieldSalesNet(id){return db.sales.filter(x=>x.fieldId===id).reduce((s,x)=>s+n(x.amount)-n(x.deduction),0)}
function renderDashboard(){
$('kpiFields').textContent=db.fields.length;$('kpiAcres').textContent=money(total(db.fields,'acres'));
const ex=total(db.expenses),sales=total(db.sales.map(s=>({amount:n(s.amount)-n(s.deduction)})));
$('kpiExpenses').textContent=money(ex);$('kpiSales').textContent=money(sales);const p=sales-ex;$('kpiProfit').textContent=money(p);$('kpiProfit').className=p<0?'loss':'profit';
const dueExp=db.expenses.reduce((s,x)=>s+Math.max(0,n(x.amount)-n(x.paid)),0);
const dueLed=db.ledger.reduce((s,x)=>s+Math.max(0,n(x.amount)-n(x.paid)),0);
const dueSales=db.sales.reduce((s,x)=>s+Math.max(0,n(x.amount)-n(x.deduction)-n(x.received)),0);
$('kpiDue').textContent=money(dueExp+dueLed+dueSales);
$('fieldSummary').innerHTML=table(['پیلی','رقبہ','فصل','کل خرچہ','خالص فروخت','فرق / منافع'],db.fields.map(f=>{const e=fieldExpenseTotal(f.id),s=fieldSalesNet(f.id),p=s-e;return `<tr><td>${esc(f.name)}<br><small>${esc(f.ownership)} زمین</small></td><td>${money(f.acres)}</td><td>${esc(f.crop||'—')}</td><td>${money(e)}</td><td>${money(s)}</td><td class="${p<0?'loss':'profit'}">${money(p)}</td></tr>`}));
const rec=[...db.expenses.map(x=>({...x,kind:'خرچہ',display:x.description})),...db.sales.map(x=>({...x,kind:'فروخت',display:x.crop+' کی فروخت'})),...db.ledger.map(x=>({...x,kind:'کھاتہ',display:x.party+' — '+x.description}))].sort((a,b)=>(b.date||'').localeCompare(a.date||'')).slice(0,8);
$('recentEntries').innerHTML=table(['تاریخ','قسم','پیلی / شخص','تفصیل','رقم'],rec.map(x=>`<tr><td>${esc(x.date)}</td><td>${x.kind}</td><td>${esc(x.fieldId?fieldName(x.fieldId):(x.party||'—'))}</td><td>${esc(x.display)}</td><td>${money(x.amount)}</td></tr>`));
}
function renderFields(){$('fieldsTable').innerHTML=table(['نام','رقبہ','ملکیت','فصل / سیزن','ٹھیکہ فی ایکڑ','کل ٹھیکہ','خرچہ','فروخت','عمل'],db.fields.map(f=>`<tr><td>${esc(f.name)}</td><td>${money(f.acres)}</td><td>${esc(f.ownership)}</td><td>${esc(f.crop||'—')}<br>${esc(f.season||'')}</td><td>${money(f.rent)}</td><td>${money(f.ownership==='ٹھیکہ'?n(f.acres)*n(f.rent):0)}</td><td>${money(fieldExpenseTotal(f.id))}</td><td>${money(fieldSalesNet(f.id))}</td><td><button class="smallbtn" data-editfield="${f.id}">ترمیم</button> ${actionBtns('field',f.id)}</td></tr>`))}
function renderExpenses(){const fid=$('filterExpenseField').value,cat=$('filterExpenseCategory').value;let list=db.expenses.filter(x=>(!fid||x.fieldId===fid)&&(!cat||x.category===cat)).sort((a,b)=>b.date.localeCompare(a.date));const cats=[...new Set(db.expenses.map(x=>x.category))];const ce=$('filterExpenseCategory');const old=ce.value;ce.innerHTML='<option value="">تمام اقسام</option>'+cats.map(c=>`<option>${esc(c)}</option>`).join('');ce.value=old;
$('expensesTable').innerHTML=`<p><b>فلٹر کے مطابق کل خرچہ: ${money(total(list))}</b></p>`+table(['تاریخ','پیلی','فصل','قسم','تفصیل','رقم','ادا','باقی','عمل'],list.map(x=>`<tr><td>${esc(x.date)}</td><td>${esc(fieldName(x.fieldId))}</td><td>${esc(x.crop||'—')}</td><td>${esc(x.category)}</td><td>${esc(x.description)}<br><small>${esc(x.qty||'')} ${esc(x.party||'')}</small></td><td>${money(x.amount)}</td><td>${money(x.paid)}</td><td>${money(Math.max(0,n(x.amount)-n(x.paid)))}</td><td>${actionBtns('expense',x.id)}</td></tr>`))}
function renderSales(){$('salesTable').innerHTML=table(['تاریخ','پیلی','فصل','مقدار','کل فروخت','کٹوتی','وصول','باقی','آڑھتی','عمل'],[...db.sales].sort((a,b)=>b.date.localeCompare(a.date)).map(x=>`<tr><td>${esc(x.date)}</td><td>${esc(fieldName(x.fieldId))}</td><td>${esc(x.crop)}</td><td>${esc(x.qty||'—')}</td><td>${money(x.amount)}</td><td>${money(x.deduction)}</td><td>${money(x.received)}</td><td>${money(Math.max(0,n(x.amount)-n(x.deduction)-n(x.received)))}</td><td>${esc(x.buyer||'—')}</td><td>${actionBtns('sale',x.id)}</td></tr>`))}
function renderLedger(){$('ledgerTable').innerHTML=table(['تاریخ','نام','قسم','پیلی','تفصیل','کل رقم','ادا / وصول','باقی','عمل'],[...db.ledger].sort((a,b)=>b.date.localeCompare(a.date)).map(x=>`<tr><td>${esc(x.date)}</td><td>${esc(x.party)}</td><td>${x.type==='payable'?'ہم نے دینے ہیں':x.type==='receivable'?'ہم نے لینے ہیں':'ادائیگی / وصولی'}</td><td>${esc(x.fieldId?fieldName(x.fieldId):'عمومی')}</td><td>${esc(x.description)}</td><td>${money(x.amount)}</td><td>${money(x.paid)}</td><td>${money(Math.max(0,n(x.amount)-n(x.paid)))}</td><td>${actionBtns('ledger',x.id)}</td></tr>`))}
$('fieldForm').onsubmit=e=>{e.preventDefault();const id=$('fieldId').value;const f={id:id||uid(),name:$('fieldName').value.trim(),acres:n($('fieldAcres').value),ownership:$('fieldOwnership').value,rent:n($('fieldRent').value),crop:$('fieldCrop').value.trim(),season:$('fieldSeason').value.trim()};if(id)db.fields=db.fields.map(x=>x.id===id?f:x);else db.fields.push(f);e.target.reset();$('fieldId').value='';$('fieldRent').value=0;save();};
$('cancelField').onclick=()=>{$('fieldForm').reset();$('fieldId').value='';$('fieldRent').value=0};
$('expenseForm').onsubmit=e=>{e.preventDefault();const amount=n($('expAmount').value),payment=$('expPayment').value;let paid=n($('expPaid').value);if(payment==='paid')paid=amount;if(payment==='due')paid=0;db.expenses.push({id:uid(),date:$('expDate').value,fieldId:$('expField').value,crop:$('expCrop').value.trim(),category:$('expCategory').value,description:$('expDescription').value.trim(),qty:$('expQty').value.trim(),amount,party:$('expParty').value.trim(),paid});e.target.reset();$('expDate').value=today();$('expPaid').value=0;save();});
$('saleForm').onsubmit=e=>{e.preventDefault();db.sales.push({id:uid(),date:$('saleDate').value,fieldId:$('saleField').value,crop:$('saleCrop').value.trim(),qty:$('saleQty').value.trim(),amount:n($('saleAmount').value),buyer:$('saleBuyer').value.trim(),deduction:n($('saleDeduction').value),received:n($('saleReceived').value),note:$('saleNote').value.trim()});e.target.reset();$('saleDate').value=today();$('saleDeduction').value=$('saleReceived').value=0;save();};
$('ledgerForm').onsubmit=e=>{e.preventDefault();db.ledger.push({id:uid(),date:$('ledDate').value,party:$('ledParty').value.trim(),type:$('ledType').value,fieldId:$('ledField').value,description:$('ledDescription').value.trim(),amount:n($('ledAmount').value),paid:n($('ledPaid').value)});e.target.reset();$('ledDate').value=today();$('ledPaid').value=0;save();};
document.addEventListener('click',e=>{const del=e.target.closest('[data-delete]');if(del){if(!confirm('کیا آپ واقعی یہ ریکارڈ حذف کرنا چاہتے ہیں؟'))return;const key={field:'fields',expense:'expenses',sale:'sales',ledger:'ledger'}[del.dataset.delete];if(key==='fields'&&(db.expenses.some(x=>x.fieldId===del.dataset.id)||db.sales.some(x=>x.fieldId===del.dataset.id))){if(!confirm('اس زمین سے منسلک ریکارڈ بھی موجود ہے۔ زمین حذف کرنے سے ریکارڈ کی نسبت ختم ہو جائے گی۔ جاری رکھیں؟'))return;}db[key]=db[key].filter(x=>x.id!==del.dataset.id);save();}const edit=e.target.closest('[data-editfield]');if(edit){const f=db.fields.find(x=>x.id===edit.dataset.editfield);if(!f)return;$('fieldId').value=f.id;$('fieldName').value=f.name;$('fieldAcres').value=f.acres;$('fieldOwnership').value=f.ownership;$('fieldRent').value=f.rent;$('fieldCrop').value=f.crop;$('fieldSeason').value=f.season;nav('fields');window.scrollTo({top:0,behavior:'smooth'});}});
$('filterExpenseField').onchange=renderExpenses;$('filterExpenseCategory').onchange=renderExpenses;
$('exportBtn').onclick=()=>{const blob=new Blob([JSON.stringify(db,null,2)],{type:'application/json'});const a=document.createElement('a');a.href=URL.createObjectURL(blob);a.download='rana-farm-khata-backup-'+today()+'.json';a.click();URL.revokeObjectURL(a.href);};
$('importFile').onchange=async e=>{const f=e.target.files[0];if(!f)return;try{const imported=JSON.parse(await f.text());if(!Array.isArray(imported.fields)||!Array.isArray(imported.expenses))throw Error('invalid');if(!confirm('بیک اپ موجودہ ڈیٹا کی جگہ لے گا۔ پہلے موجودہ ڈیٹا کا بیک اپ لے لیں۔ جاری رکھیں؟'))return;db={...db,...imported};save();alert('بیک اپ واپس آگیا۔')}catch(err){alert('یہ بیک اپ فائل درست نہیں۔')}e.target.value='';};
$('saveSettings').onclick=()=>{db.settings.name=$('settingName').value.trim()||'Rana Farm Khata';save();alert('نام محفوظ ہوگیا۔')};
$('runReport').onclick=runReport;
function runReport(){if(!$('reportCards'))return;const fid=$('reportField').value,crop=$('reportCrop').value.trim().toLowerCase();const ex=db.expenses.filter(x=>(!fid||x.fieldId===fid)&&(!crop||(x.crop||'').toLowerCase().includes(crop)));const sa=db.sales.filter(x=>(!fid||x.fieldId===fid)&&(!crop||(x.crop||'').toLowerCase().includes(crop)));const et=total(ex),st=sa.reduce((s,x)=>s+n(x.amount)-n(x.deduction),0),profit=st-et;const cards=[['اخراجات',money(et)],['خالص فروخت',money(st)],['فرق / منافع',money(profit)],['فروخت کی تعداد',sa.length]];$('reportCards').innerHTML=cards.map(([a,b])=>`<div class="card"><span>${a}</span><strong>${b}</strong></div>`).join('');const map={};ex.forEach(x=>map[x.category]=(map[x.category]||0)+n(x.amount));$('categoryReport').innerHTML=table(['خرچے کی قسم','کل رقم'],Object.entries(map).sort((a,b)=>b[1]-a[1]).map(([k,v])=>`<tr><td>${esc(k)}</td><td>${money(v)}</td></tr>`));$('reportSales').innerHTML=table(['تاریخ','پیلی','فصل','فروخت','کٹوتی','وصول','باقی'],sa.map(x=>`<tr><td>${esc(x.date)}</td><td>${esc(fieldName(x.fieldId))}</td><td>${esc(x.crop)}</td><td>${money(x.amount)}</td><td>${money(x.deduction)}</td><td>${money(x.received)}</td><td>${money(Math.max(0,n(x.amount)-n(x.deduction)-n(x.received)))}</td></tr>`));}
function applySettings(){$('brandName').textContent=db.settings.name||'Rana Farm Khata'}
window.addEventListener('beforeinstallprompt',e=>{e.preventDefault();deferredInstall=e;$('installBtn').classList.remove('hidden')});
$('installBtn').onclick=async()=>{if(!deferredInstall){alert('Chrome کے مینو میں Add to Home screen / Install app منتخب کریں۔');return}deferredInstall.prompt();await deferredInstall.userChoice;deferredInstall=null;$('installBtn').classList.add('hidden')};
if('serviceWorker'in navigator)window.addEventListener('load',()=>navigator.serviceWorker.register('./sw.js').catch(()=>{}));
load();
